# PORT (wajib diisi di panel hosting Node.js)
PORT=3000

# BIND DI HOST
HOST_BIND=127.0.0.1

# AUTH SERVER (wajib)
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_PANJANG

# CLIENT (dipakai CLI saat --server)
OPENCODE_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_PANJANG_YANG_SAMA

# Penyimpanan persisten (opsional; isi kalau platform menyediakan disk persisten)
# XDG_DATA_HOME=/path/persisten
# OPENCODE_DB=/path/persisten/opencode/opencode.db

# Provider model (opsional; free tier tetap bisa dipakai tanpa ini)
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
