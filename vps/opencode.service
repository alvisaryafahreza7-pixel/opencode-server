[Unit]
Description=OpenCode API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opencode
Group=opencode
Environment=OPENCODE_SERVER_USERNAME=opencode
# Berisi OPENCODE_SERVER_PASSWORD=... (chmod 600)
EnvironmentFile=/etc/opencode/server.env
ExecStart=/home/opencode/.opencode/bin/opencode serve --hostname 127.0.0.1 --port 4096
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
